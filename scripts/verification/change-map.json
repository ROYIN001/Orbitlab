    {
      "id": "app-misc",
      "why": "WebMCP and credits.",
      "paths": ["src/mcp.ts", "src/credits.ts"],
      "checks": { "unit": ["tests/mcp.test.ts"], "browser": ["launch-explore"] }
    },
    {
      "id": "test-harnesses",
      "why": "Shared unit harnesses, fixtures and validation helpers feed many files and the slow suites.",
      "paths": ["tests/*.ts", "tests/fixtures/**", "tests/validation/*.ts"],
      "exclude": ["tests/*.test.ts", "tests/validation/*.test.ts", "tests/**/*.md"],
      "checks": { "unit": ["*"], "heavy": ["*"], "sixdof-fleet": ["*"] }

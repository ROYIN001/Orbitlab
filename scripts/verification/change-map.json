      "paths": ["scripts/bundle-budget.mjs"],
      "checks": { "commands": ["@app-build"], "unit": ["tests/bundle-budget.test.ts"] }
    },
    {
      "id": "science-validation-scripts",
      "why": "npm run validate:science collectors and report readers.",
      "paths": ["scripts/validation-*"],
      "checks": { "unit": ["tests/validation-*.test.ts"] }
    },
    {
      "id": "consumed-markdown",
      "why": "The three Markdown files the app or tests read (lib.mjs sourceIdentity, workflow-paths test).",
      "paths": ["docs/ROADMAP-PART2-3.md", "docs/SIXDOF-VEHICLE-DATA.md", "docs/history/phase4-2026-10-01/T03-CURRICULA-RESEARCH.md"],

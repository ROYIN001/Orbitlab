      "exclude": ["tests/browser/shard.test.mjs"],
      "checks": { "commands": ["node-verification", "build"], "browser": ["*"] }
    },
    {
      "id": "verification-workflows",
      "why": "VERIFICATION.md verification/workflows/inventory row (actionlint is run separately).",
      "paths": ["scripts/verification/**", "scripts/html-comments.mjs", "tests/verification/**", ".github/**", ".gitattributes", ".gitignore"],
      "checks": { "commands": ["node-verification"], "unit": ["tests/repo-hygiene.test.ts"] }
    },
    {
      "id": "bundle-budget-script",

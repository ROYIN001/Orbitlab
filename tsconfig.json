{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests"],
  // tests/probe is gitignored scratch space for throwaway probes (audit B42).
  // Without this line a probe someone forgets to delete breaks `npm run build`
  // (tsc --noEmit) for everyone — it has already cost two review gates.
  "exclude": ["tests/probe"]
}

+vec3 pc = o + dir * tc;
+float rp2 = dot(pc, pc);
+float tStart = max(0.0, tc - sqrt(max(0.0, RT * RT - rp2)));
+float tEnd = rp2 < rEnd * rEnd ? tc - sqrt(rEnd * rEnd - rp2) : tc;
+float len = max(tEnd - tStart, 0.0);
+float c = dot(dir, sunDir), pr = rayleighPhase(c), pm = miePhase(c);
+vec3 pEnd = o + dir * tEnd;

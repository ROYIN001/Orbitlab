{
  "name": "orbitlab",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Physics-based rocket launch and orbital insertion simulator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:heavy": "vitest run --config vitest.heavy.config.ts",
    "test:sixdof-fleet": "vitest run --config vitest.sixdof-fleet.config.ts",
    "test:browser": "npm run build && node tests/browser/run.mjs",
    "test:browser:smoke": "node tests/browser/run.mjs --smoke",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "snapshots": "node --experimental-strip-types scripts/refresh-snapshots.ts",
    "shots": "node --experimental-strip-types scripts/shots.ts"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
